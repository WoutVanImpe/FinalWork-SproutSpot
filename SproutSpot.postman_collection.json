						"body": {
							"mode": "raw",
							"raw": "{\n  \"push_token\": \"expo-push-token-here\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/push-token",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "push-token"]
						}
					}
				}
			]
		},
